generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  STUDENT
  ADMIN
}

enum SeatStatus {
  AVAILABLE
  PENDING
  OCCUPIED
  OCCUPIED_ON_BREAK
  UNAVAILABLE
}

// PENDING/CONFIRMED are the active states; the rest are terminal states,
// kept distinct for occupancy analytics
//   CANCELLED  — entry-timer expired before front-desk approval (no-show)
//   FORFEITED  — break timer expired before the student returned
//   EVICTED    — community-flagged as vacant, not re-verified in time
//   VOIDED     — staff manually ended it
//   COMPLETED  — student checked out normally
enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FORFEITED
  EVICTED
  VOIDED
  COMPLETED
}

// A student re-validating their presence via QR scan. 
enum ValidationEventType {
  BREAK_RETURN
  FLAG_REVERIFICATION
}

// Seat-level occupancy timeline.
enum OccupancyEventType {
  OCCUPIED
  VACATED
}

// No password field, auth is Google OAuth only.
model User {
  id             String   @id @default(uuid(7)) // v7: sortable, better index locality
  googleId       String   @unique @map("google_id") // stable OAuth key; email can change
  email          String   @unique
  name           String
  role           UserRole @default(STUDENT)
  studentIdLast4 String?  @map("student_id_last4") // set during post-OAuth registration step
  reservations Reservation[]
  flagsRaised SeatFlag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Seat {
  id             String     @id @default(uuid(7))
  building       String
  floor          Int
  status         SeatStatus @default(AVAILABLE)
  currentQrToken String     @unique @default(uuid(7)) @map("current_qr_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservations Reservation[]
  seatFlags SeatFlag[]

  @@index([building, floor]) // supports GET /seats?building=&floor= 
  @@map("seats")
}

model Reservation {
  id     String            @id @default(uuid(7))
  userId String            @map("user_id")
  seatId String            @map("seat_id")
  status ReservationStatus @default(PENDING)

  // Restrict, not Cascade
  // Deleting a user/seat should never silently
  // wipe reservation history that occupancy analytics depends on. Seats
  // are meant to be retired via status = UNAVAILABLE, not deleted.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at") // set when front desk approves; null = never occupied
  endedAt     DateTime? @map("ended_at") // set on any terminal status

  validationEvents ValidationEvent[]
  occupancyLogs OccupancyLog[]
  seatFlags SeatFlag[]

  @@index([userId])
  @@index([seatId])
  @@index([status, createdAt]) // supports admin's pending-queue dashboard
    // NOTE: "one active (PENDING/CONFIRMED) reservation per seat/user" is
    // enforced by two partial unique indexes hand-written directly into a
    // migration file (prisma/migrations/..._add_active_reservation_constraints/
    // migration.sql), Prisma 6's schema syntax can't express a WHERE clause
    // on an index, so this constraint is invisible here but real in the DB.
  @@map("reservations")
}

model ValidationEvent {
  id            String              @id @default(uuid(7))
  reservationId String              @map("reservation_id")
  eventType     ValidationEventType @map("event_type")
  extensionsUsed Int? @map("extensions_used")

  // Cascade here, an event has no standalone meaning without its reservation, so it
  // should go with it if the reservation is ever hard-deleted.
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") // append-only log; no updatedAt

  @@index([reservationId])
  @@map("validation_events")
}

model OccupancyLog {
  id            String             @id @default(uuid(7))
  reservationId String             @map("reservation_id")
  eventType     OccupancyEventType @map("event_type")

  // userId and seatId is derived from reservationId
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") // append-only log; no updatedAt

  @@index([reservationId])
  @@map("occupancy_logs")
}

// A community report that an OCCUPIED seat looks vacant. The holder has
// until expiresAt to re-verify, and every flag ends in exactly one terminal
// status. A front-desk ghost-seat confirmation is recorded as VOIDED.
enum SeatFlagStatus {
  ACTIVE
  REVERIFIED // holder scanned the verify QR in time
  EVICTED // window expired without re-verification
  VOIDED // staff ended the reservation
  CHECKED_OUT // holder checked out first
}

model SeatFlag {
  id            String         @id @default(uuid(7))
  seatId        String         @map("seat_id")
  reservationId String         @map("reservation_id")
  flaggedById   String         @map("flagged_by_id")
  status        SeatFlagStatus @default(ACTIVE)

  // Cascade on reservation: a flag has no meaning without the reservation
  // it targets (same as ValidationEvent/OccupancyLog). Restrict on seat and
  // flagger so abuse history can't vanish if either is ever deleted.
  seat        Seat        @relation(fields: [seatId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  flaggedBy   User        @relation(fields: [flaggedById], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  resolvedAt DateTime? @map("resolved_at") // null while ACTIVE

  @@index([status, expiresAt]) // eviction job: active flags past their deadline
  @@index([flaggedById, createdAt]) // flagger cooldown lookup
  @@index([reservationId])
  // NOTE: "one ACTIVE flag per seat" and "resolved_at is set exactly when the
  // flag is resolved" are enforced by a partial unique index and a CHECK
  // constraint hand-written into prisma/migrations/..._add_seat_flags/
  // migration.sql. Prisma's schema syntax can express neither.
  @@map("seat_flags")
}
