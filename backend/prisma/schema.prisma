// AdDU-Seats database schema — Phase 3
// Prisma manages migrations and type-safe queries against PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  student
  staff
  admin

  @@map("user_role")
}

enum Building {
  gisbert
  miguel_pro

  @@map("building")
}

enum SeatType {
  individual
  table_node
  cubicle

  @@map("seat_type")
}

enum SeatStatus {
  available
  pending
  pending_verification
  occupied
  on_break
  disabled

  @@map("seat_status")
}

enum ReservationStatus {
  pending
  pending_entry
  active
  on_break
  completed
  expired
  cancelled

  @@map("reservation_status")
}

enum ValidationEventType {
  front_desk_approved
  front_desk_rejected
  break_started
  break_extended
  break_returned
  break_expired
  flagged
  flag_resolved

  @@map("validation_event_type")
}

enum OccupancyEventType {
  occupied
  vacated
  break_start
  break_end

  @@map("occupancy_event_type")
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  userId       String   @id @default(uuid()) @map("user_id") @db.Uuid
  googleId      String?  @unique @map("google_id")
  role         UserRole @default(student)
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  adduIdLast4  String?  @map("addu_id_last4") @db.VarChar(4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  reservations         Reservation[]
  validationEvents     ValidationEvent[] @relation("AdminValidationEvents")
  flaggedReservations  Reservation[]     @relation("FlaggedReservations")

  @@map("users")
}

model Seat {
  seatId         String     @id @default(uuid()) @map("seat_id") @db.Uuid
  building       Building
  floor          Int
  seatType       SeatType   @map("seat_type")
  status         SeatStatus @default(available)
  posX           Float?     @map("pos_x")
  posY           Float?     @map("pos_y")
  currentQrToken String?    @map("current_qr_token") @db.VarChar(255)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  reservations  Reservation[]
  occupancyLogs OccupancyLog[]

  @@index([status])
  @@index([building, floor])
  @@map("seats")
}

model Reservation {
  reservationId    String            @id @default(uuid()) @map("reservation_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  seatId           String            @map("seat_id") @db.Uuid
  status           ReservationStatus @default(pending)
  reservedAt       DateTime          @default(now()) @map("reserved_at") @db.Timestamp(6)
  entryDeadline    DateTime?         @map("entry_deadline") @db.Timestamp(6)
  verifiedAt       DateTime?         @map("verified_at") @db.Timestamp(6)
  checkedOutAt     DateTime?         @map("checked_out_at") @db.Timestamp(6)
  breakStartedAt   DateTime?         @map("break_started_at") @db.Timestamp(6)
  breakDeadline    DateTime?         @map("break_deadline") @db.Timestamp(6)
  breakMinutesUsed Int               @default(0) @map("break_minutes_used")
  cooldownUntil    DateTime?         @map("cooldown_until") @db.Timestamp(6)
  flaggedAt        DateTime?         @map("flagged_at") @db.Timestamp(6)
  flaggedBy        String?           @map("flagged_by") @db.Uuid

  user             User              @relation(fields: [userId], references: [userId])
  seat             Seat              @relation(fields: [seatId], references: [seatId])
  flagger          User?             @relation("FlaggedReservations", fields: [flaggedBy], references: [userId])
  validationEvents ValidationEvent[]

  @@index([userId])
  @@index([seatId])
  @@index([status])
  @@map("reservations")
}

model ValidationEvent {
  eventId       String              @id @default(uuid()) @map("event_id") @db.Uuid
  reservationId String              @map("reservation_id") @db.Uuid
  adminId       String?             @map("admin_id") @db.Uuid
  eventType     ValidationEventType @map("event_type")
  note          String?
  timestamp     DateTime            @default(now()) @db.Timestamp(6)

  reservation Reservation @relation(fields: [reservationId], references: [reservationId])
  admin       User?       @relation("AdminValidationEvents", fields: [adminId], references: [userId])

  @@index([reservationId])
  @@map("validation_events")
}

model OccupancyLog {
  logId     String             @id @default(uuid()) @map("log_id") @db.Uuid
  seatId    String             @map("seat_id") @db.Uuid
  eventType OccupancyEventType @map("event_type")
  timestamp DateTime           @default(now()) @db.Timestamp(6)

  seat Seat @relation(fields: [seatId], references: [seatId])

  @@index([seatId])
  @@index([timestamp])
  @@map("occupancy_logs")
}
