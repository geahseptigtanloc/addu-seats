# PostgreSQL connection string
# Example: postgresql://postgres:password@localhost:5432/addu_seats
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/addu_seats

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# JWT secret for session tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Reserved for future cookie-based sessions
SESSION_SECRET=change-me-to-another-random-string

# Server port
PORT=3001

# Frontend URL (used for CORS and OAuth redirect after login)
FRONTEND_URL=http://localhost:5173
